{
  "name": "Revive Razorpay Failure Catalogue",
  "version": "1.0",
  "source_policy": "Only documented Razorpay payment failure scenarios should be added. Runtime webhook values remain authoritative.",
  "notes": [
    "error_code, error_reason, error_description, error_source and error_step must be taken from the actual Razorpay event when available.",
    "Descriptions in this catalogue are normalized summaries for classification, not replacements for the raw Razorpay error_description.",
    "Payment Links, Payment Pages and Checkout are collection surfaces; their underlying payment failures are classified by payment method.",
    "Subscription failures also involve subscription lifecycle events such as pending and halted."
  ],
  "failure_categories": [
    {
      "category": "temporary",
      "description": "Potentially recoverable without changing the payment instrument."
    },
    {
      "category": "customer_action_required",
      "description": "Customer may need to correct or update something before recovery."
    },
    {
      "category": "instrument_problem",
      "description": "The payment instrument is blocked, expired, inactive or otherwise unusable."
    },
    {
      "category": "limit_or_balance",
      "description": "Balance, transaction limit or frequency restriction prevented payment."
    },
    {
      "category": "risk_or_compliance",
      "description": "Risk, authentication or policy controls prevented payment."
    },
    {
      "category": "configuration",
      "description": "Payment method or account configuration prevented the payment."
    },
    {
      "category": "subscription_lifecycle",
      "description": "Recurring payment/subscription state requires handling."
    }
  ],
